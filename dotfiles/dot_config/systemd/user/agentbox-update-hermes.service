[Unit]
Description=Update Hermes Agent and WebUI with health checks, repair and rollback
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/agentbox-update-hermes
# Update, a time-boxed OpenCode repair and a rollback can take a while.
TimeoutStartSec=2h
