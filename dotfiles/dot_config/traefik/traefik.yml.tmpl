entryPoints:
  websecure:
    address: ":443"

providers:
  file:
    directory: {{ joinPath .chezmoi.homeDir ".config/traefik/dynamic" }}
    watch: true

certificatesResolvers:
  cloudflare:
    acme:
      email: admin@{{ .base_domain }}
      storage: {{ joinPath .chezmoi.homeDir ".config/traefik/acme.json" }}
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"

log:
  level: INFO
