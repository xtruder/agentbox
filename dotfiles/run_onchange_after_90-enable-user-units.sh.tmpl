#!/usr/bin/env bash
set -euo pipefail

# Unit hashes:
{{- range (glob (joinPath .chezmoi.sourceDir "dot_config/systemd/user/*")) }}
# {{ base . }} {{ include . | sha256sum }}
{{- end }}
systemctl --user daemon-reload
# Units whose configuration is not migrated yet are skipped by their
