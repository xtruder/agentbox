+
+function _resetVaultCardState() {
+  _vaultSessionId = null;
+  _vaultPromptId = null;
+  _vaultKind = null;
+  _vaultSignature = '';
+  _vaultExpiresAt = 0;
+  _vaultVisibleSince = 0;
