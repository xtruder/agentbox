+            assert vp.respond_vault("s1", entry.prompt_id, {"password": "hunter2"})
+            t.join(timeout=3)
+            assert result["values"].get("password") == "hunter2"
+            assert vp.get_pending("s1") is None
+            assert vp.pending_count("s1") == 0
+        finally:
+            vp.unregister_gateway_notify("s1")
+            vp.clear_pending("s1")
