#!/usr/bin/env bash
# Visible Google Chrome that Hermes drives over CDP on 127.0.0.1:9222.
set -euo pipefail

# Chrome 136+ ignores --remote-debugging-port on the default profile, so the
# automation browser always uses its own user data directory.
profile="$HOME/.hermes/chrome-cdp"
mkdir -p "$profile"

# The VM has no GPU; software rendering avoids GPU process failures.
exec /usr/bin/google-chrome-stable \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --user-data-dir="$profile" \
  --no-first-run \
  --no-default-browser-check \
  --disable-blink-features=AutomationControlled \
  --password-store=gnome-libsecret \
  --disable-gpu \
  about:blank
